#!/usr/bin/env bash
# The suite itself lives in flake.nix, under `checks`. CI runs `nix flake check`
# directly; this script is the local ergonomics on top of it — cheapest first,
# a ✓/✗ per step — plus the one check that cannot run in a build sandbox.
#
# Runs standalone: it calls nix itself and no longer needs `nix develop`.
set -uo pipefail
readonly ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

fail=0
run() {
  local name="$1"; shift
  printf '\n\033[1m── %s ─────────────────────────\033[0m\n' "$name"
  if "$@"; then
    printf '\033[32m✓ %s\033[0m\n' "$name"
  else
    printf '\033[31m✗ %s\033[0m\n' "$name"
    fail=1
  fi
}

# fmt, clippy, test, typos, machete, taplo, deny (bans/licenses/sources) and the
# .pi extension tests. Each is its own derivation, so nix caches and parallelises
# them: a docs-only edit is a no-op, a src edit does not re-run taplo.
run "flake check" nix flake check --print-build-logs

# Not in the flake: this fetches the RustSec advisory database, and the sandbox
# has no network. Pinning the database is not an option either — cargo-deny
# locates it through a hashed db-path directory that is an internal detail.
# So advisories are checked here and in the scheduled CI job, not per-build.
run "advisories" nix develop --command cargo deny check advisories

if [[ $fail -eq 0 ]]; then
  printf '\n\033[32m\033[1mall checks passed\033[0m\n'
else
  printf '\n\033[31m\033[1msome checks failed\033[0m\n'
fi
exit $fail
