#!/usr/bin/env bash
# Everything CI would run, in the order that fails cheapest-first.
# Requires the dev shell: `nix develop --command ./check`
set -uo pipefail
readonly ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

fail=0
run() {
  local name="$1"; shift
  printf '\n\033[1m── %s ─────────────────────────\033[0m\n' "$name"
  if "$@"; then
    printf '\033[32m✓ %s\033[0m\n' "$name"
  else
    printf '\033[31m✗ %s\033[0m\n' "$name"
    fail=1
  fi
}

run "fmt"      cargo fmt --check
run "taplo"    taplo fmt --check Cargo.toml
run "clippy"   cargo clippy --all-targets -- -D warnings
run "test"     cargo test
run "typos"    typos
run "machete"  cargo machete
run "deny"     cargo deny check

# The pi extension's document builder. Node is deliberately not in the dev
# shell — it is a launcher for one host, not a build dependency of the binary —
# so this is skipped when node is absent rather than failing the run.
if command -v node >/dev/null 2>&1; then
  run "extension" node --test .pi/extensions/marginal-annotate.test.mjs
else
  printf '\n\033[33m– extension tests skipped (no node)\033[0m\n'
fi

if [[ $fail -eq 0 ]]; then
  printf '\n\033[32m\033[1mall checks passed\033[0m\n'
else
  printf '\n\033[31m\033[1msome checks failed\033[0m\n'
fi
exit $fail
