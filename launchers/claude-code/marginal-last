#!/usr/bin/env bash
#
# marginal-last — review Claude Code's last assistant message(s) in marginal.
#
# The Claude Code counterpart of .pi/extensions/marginal-annotate.ts. Same
# document model, different host: pi owns the terminal and can suspend its own
# TUI, Claude Code runs the launcher from a tool call whose stdio is captured.
# So the tty is borrowed rather than suspended — a tmux popup on the client
# showing Claude's own pane, or a terminal window when there is no tmux.
#
#   marginal-last          the last assistant message, bare
#   marginal-last 3        the last 3 assistant messages, plus the prompts between
#   marginal-last all      the whole session
#   marginal-last --dump   print the assembled document, launch nothing
#
# The transcript is cut at the most recent user prompt before anything is
# assembled: that prompt is the `/marginal-last` invocation itself, so what is
# offered for review is the message the human had actually read when they asked
# — never the half-finished turn that is running this script.
#
# Binary resolution, in order:
#   $MARGINAL_BIN  →  <repo>/target/release/marginal  →  the packaged binary
#   →  `marginal` on PATH
#
# Exit codes:
#   0  handled — stdout is either the feedback or "No annotations"
#   2  the gate could not run, at any stage, for any reason
#
# marginal's own 0/1 split is deliberately not propagated: a tool call that
# exits non-zero reads as a broken command, and "the human commented" is not a
# failure. The distinction is carried in stdout, which is what the agent reads.

set -euo pipefail
trap 'exit 2' ERR   # every failure leaves by the documented door, jq's included

die() { printf 'marginal-last: %s\n' "$*" >&2; exit 2; }

# The binary lookup and the tty borrowing, shared with marginal-diff. The flake
# rewrites the sentinel to the installed copy; a checkout finds it at
# launchers/lib, by a path the kernel resolves through the skill symlink.
launch_lib="@marginalLaunchLib@"
[ -f "$launch_lib" ] || launch_lib="$(dirname "${BASH_SOURCE[0]}")/../lib/marginal-launch.bash"
# shellcheck source=SCRIPTDIR/../lib/marginal-launch.bash
. "$launch_lib"

# ---------------------------------------------------------------- arguments

dump_only=0
spec=1
for arg in "$@"; do
  case "$arg" in
    --dump) dump_only=1 ;;
    all|ALL) spec="all" ;;
    ''|*[!0-9]*) die "usage: marginal-last [N|all] [--dump]  (got '$arg')" ;;
    # base 10 explicitly: `08` is not an octal literal here, it is eight
    *) spec=$((10#$arg)); [ "$spec" -gt 0 ] || die "N must be a positive integer (got '$arg')" ;;
  esac
done

command -v jq >/dev/null || die "jq is required to read the session transcript"

# ---------------------------------------------------------------- transcript
#
# $CLAUDE_CODE_SESSION_ID names the transcript exactly. There is deliberately no
# fallback: a project directory holds hundreds of past sessions, two windows open
# on one repo share it, and picking by mtime would hand over a conversation the
# human was never in — silently, and with no way to notice from the document.

[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] \
  || die "\$CLAUDE_CODE_SESSION_ID is unset — cannot identify this session's transcript"

transcript=""
for candidate in "$HOME"/.claude/projects/*/"$CLAUDE_CODE_SESSION_ID".jsonl; do
  if [ -f "$candidate" ]; then transcript="$candidate"; break; fi
done
[ -n "$transcript" ] || die "no transcript for session $CLAUDE_CODE_SESSION_ID"

# ---------------------------------------------------------------- document
#
# Thinking blocks, tool calls and tool results carry no prose worth annotating
# and are dropped, so the numbering counts messages that survived rather than
# turns of the agent loop.
#
# Claude Code also writes machine traffic as ordinary `user` messages: task
# notifications, `!command` input and its output, slash-command stubs. All of it
# is kept out of the document, but the two kinds are not interchangeable — a
# stub records that the human invoked something and is therefore a valid place
# to cut, while a notification that landed mid-turn is not, and cutting there
# would leave the in-flight turn in the document.

read -r -d '' JQ_PROG <<'JQ' || true
def turn_text:
  if (.message.content | type) == "string" then .message.content
  else [ .message.content[]? | select(.type == "text") | .text ] | join("\n\n")
  end;

def trimmed: gsub("^\\s+|\\s+$"; "");

# Claude Code's own tags, by name. Matching any `^<tag>` used to take a real
# prompt that starts with `<div>` out of the document, leaving the answer to a
# question the document no longer showed.
#
# anything the human did not type — never the cut point
def machine:
  test("^<(task-notification|bash-notification|bash-stdout|bash-stderr|local-command-stdout|local-command-stderr|local-command-caveat|system-reminder)>")
  # written when the human presses Esc, and not a prompt either
  or test("^\\[Request interrupted by user[^\\]]*\\]$");
# anything machine, or a stub of something the human invoked — never part of
# the document
def plumbing:
  machine
  or test("^<(command-name|command-message|command-args|bash-input|user-memory-input|background-task-input)>");

# Raw lines, parsed one at a time. The transcript is appended to while this
# runs — by the very turn that invoked it — so its last line can be half
# written, and `jq -s` failed the whole read over it. A line that does not
# parse is skipped; every complete one before it is still there.
[ inputs | fromjson? // empty
  | select((.isSidechain // false) | not)
  | select((.isMeta // false) | not)
  # the summary `/compact` leaves behind, written as a user message that
  # nobody typed
  | select((.isCompactSummary // false) | not)
  | select(.type == "assistant" or .type == "user")
  | select(.message.role == "assistant" or .message.role == "user")
  # Claude Code's own stand-ins for a reply the model never gave: "No response
  # requested." after an interrupt, "API Error: …" after a failed request.
  # Neither is a message anyone read as the agent's answer.
  | select(.message.model != "<synthetic>")
  | select((.isApiErrorMessage // false) | not)
  | { role: .message.role, text: ((turn_text // "") | trimmed) }
  | select(.text != "")
]

# cut at the invoking prompt
| . as $all
| ([ range(0; $all | length)
     | select($all[.].role == "user" and ($all[.].text | machine | not)) ] | last) as $cut
| (if $cut == null then $all else $all[0:$cut] end)

| [ .[] | select((.role == "user" and (.text | plumbing)) | not) ]

| . as $turns
| ([ range(0; $turns | length) | select($turns[.].role == "assistant") ]) as $ai
| if ($ai | length) == 0 then null
  elif $count == 1 then
    { label: "assistant-message", text: ($turns[$ai[-1]].text + "\n") }
  else
    (if $count == "all" then 0
     elif ($ai | length) > $count then $ai[-($count + 1)] + 1
     else 0 end) as $start
    | { label: "conversation",
        text: ([ $turns[$start:] | to_entries[]
                 | "## " + (if .value.role == "user" then "you" else "agent" end)
                   + " [" + (.key + 1 | tostring) + "]\n\n" + .value.text ]
               | join("\n\n")) + "\n" }
  end
JQ

# --argjson so `1` is a number and `01` cannot become a different view
if [ "$spec" = "all" ]; then count_arg='"all"'; else count_arg="$spec"; fi
document="$(jq -nR --argjson count "$count_arg" "$JQ_PROG" "$transcript")"
[ "$document" != "null" ] || die "no assistant message with text in $(basename "$transcript")"

workdir="$(mktemp -d -t claude-code.marginal-last.XXXXXX)"
trap 'marginal_release_tty; rm -rf "$workdir"' EXIT
result_json="$workdir/result.json"

label="$(printf '%s' "$document" | jq -r '.label')"
source_md="$workdir/$label.md"
# -j, not -r: the document already ends in its own newline
printf '%s' "$document" | jq -j '.text' > "$source_md"

if [ "$dump_only" -eq 1 ]; then
  printf '# %s (%s, from %s)\n\n' "$label" "$spec" "$(basename "$transcript")"
  cat "$source_md"
  exit 0
fi

# ---------------------------------------------------------------- the tty
#
# Both halves live in launchers/lib/marginal-launch.bash, with the measured
# gotchas that shaped them.

binary="$(marginal_find_binary)"
marginal_run_on_tty "$label" "$binary" --result "$result_json" --label "$label" "$source_md"
rc=$MARGINAL_RC

# ---------------------------------------------------------------- feedback
#
# The result file is the verdict when it says `"final": true`; $rc is only ever
# a diagnostic. marginal writes it final in `finish`, after the last keypress and
# before it picks its own exit code, and autosaves it non-final after every
# change before that (see marginal_result_final in the library). Reading $rc for
# the annotated/clean split would report "no annotations" over real feedback on
# the alacritty path, where rc is always 0.
#
# A missing file does NOT mean the TUI never ran. It usually does — a popup that
# could not open, a second popup on a client that already has one, a binary that
# failed to start — but `finish`'s write can also fail after a complete session,
# and then marginal exits 2 and prints the review to stdout instead, because the
# markdown is the last copy of the annotations. Measured, in a 90x30 pane:
# annotate, delete the --result directory, quit -> no file, the full
# "# Review feedback" on stdout, rc=2. `display-popup -E` closes that pane on
# exit, so nothing here ever sees it.
#
# So the message below says what is actually known — no verdict — rather than
# claiming nothing happened. Exiting 2 stays correct either way: a gate with no
# verdict must not answer for the human. What is NOT handled is rescuing the
# review in that lost-write case; that needs the popup's stdout captured to a
# file and read back here, which is a change to what this script does and wants
# its own commit.

[ -f "$result_json" ] \
  || die "no result file from marginal (launcher rc=$rc) — no verdict is available." \
         "It most likely never started, but a session that ran and could not write its" \
         "result looks identical from here, and takes the review with it."

final="$(marginal_result_final "$result_json")"
count="$(jq -r '.annotations | length' "$result_json")"
feedback="$(jq -r '.feedbackMarkdown // ""' "$result_json")"
if [ -z "${feedback//[[:space:]]/}" ]; then count=0; fi

# An interrupted review: its notice first, or exit 2 when it holds nothing.
marginal_check_interrupted "$final" "$count"
if [ "$count" -eq 0 ]; then
  echo "No annotations — nothing to address."
  exit 0
fi

# No preface explaining the format: SKILL.md does, and it is always in context
# here, because the skill can only be invoked by the user.
printf '%s\n' "$feedback"
